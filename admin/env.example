# API Base URLs for BNGdrasil Admin Panel

# Main API Gateway URL
VITE_API_BASE_URL=https://api.bnbong.com

# Admin API URL (Bifrost Gateway Admin endpoints)
VITE_ADMIN_API_BASE_URL=https://api.bnbong.com/admin/api

# For local development, use the ingress from the root docker-compose `ui`
# profile. VITE_API_BASE_URL carries both /auth/* (Bidar, port 8001) and
# /ready (Bifrost, port 8000), and only the ingress splits them apart, so a
# direct container port will not work for both:
# VITE_API_BASE_URL=http://api.localhost:8080
# VITE_ADMIN_API_BASE_URL=http://api.localhost:8080/admin/api

# Grafana base URL used by the observability page (link-out only).
VITE_GRAFANA_URL=https://monitoring.bnbong.com
